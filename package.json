{
  "name": "photo-slide",
  "version": "1.2.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder -m",
    "release": "release-it"
  },
  "build": {
    "appId": "com.kawasaki.photo-slide",
    "productName": "PhotoSlide",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        "zip"
      ],
      "category": "public.app-category.photography",
      "icon": "icon.png"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "icon.png"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "release-it": "^19.2.4"
  }
}
